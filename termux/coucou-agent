#!/data/data/com.termux/files/usr/bin/python
import json, os, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

HOST='127.0.0.1'; PORT=8766
ROOT=Path.home()/'projetos'; ROOT.mkdir(exist_ok=True)

def safe_name(name):
    clean=''.join(c for c in name if c.isalnum() or c in '._-')
    if not clean or clean in {'.','..'}: raise ValueError('Nome de projeto inválido')
    return clean

def project_path(name):
    p=(ROOT/safe_name(name)).resolve()
    if ROOT.resolve() not in p.parents: raise ValueError('Caminho inválido')
    return p

def run(args, cwd=None, timeout=120):
    p=subprocess.run(args,cwd=cwd,text=True,capture_output=True,timeout=timeout)
    return p.returncode,p.stdout.strip(),p.stderr.strip()

class H(BaseHTTPRequestHandler):
    def log_message(self, *args): pass
    def send(self, code, payload):
        data=json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(code); self.send_header('Content-Type','application/json; charset=utf-8'); self.send_header('Content-Length',str(len(data))); self.end_headers(); self.wfile.write(data)
    def read_json(self):
        n=int(self.headers.get('Content-Length','0')); return json.loads(self.rfile.read(n) or b'{}')
    def do_GET(self):
        if self.path=='/ping': return self.send(200,{'ok':True,'service':'coucou-termux-agent','root':str(ROOT),'port':PORT})
        return self.send(404,{'ok':False})
    def do_POST(self):
        try:
            data=self.read_json(); name=safe_name(data.get('name','')); path=project_path(name)
            clone=data.get('cloneUrl',''); branch=data.get('branch','main')
            if self.path=='/project/status':
                if not path.exists(): return self.send(200,{'ok':True,'installed':False})
                code,out,err=run(['git','status','--porcelain'],cwd=path)
                _,b,_=run(['git','branch','--show-current'],cwd=path)
                return self.send(200,{'ok':True,'installed':True,'dirty':bool(out),'branch':b or branch})
            if self.path=='/project/clone':
                if path.exists(): return self.send(409,{'ok':False,'error':'Projeto já está baixado.'})
                parsed=urlparse(clone)
                if parsed.scheme!='https' or parsed.netloc!='github.com': return self.send(400,{'ok':False,'error':'Somente URLs HTTPS do github.com são aceitas.'})
                code,out,err=run(['git','clone','--branch',branch,'--single-branch',clone,str(path)],timeout=300)
                if code: return self.send(500,{'ok':False,'error':err or out})
                return self.send(200,{'ok':True,'message':f'{name} baixado em {path}'})
            if self.path=='/project/pull':
                if not path.exists(): return self.send(404,{'ok':False,'error':'Projeto ainda não foi baixado.'})
                code,out,err=run(['git','status','--porcelain'],cwd=path)
                if out: return self.send(409,{'ok':False,'error':'Existem alterações locais. Commit/stash antes de atualizar.'})
                code,out,err=run(['git','pull','--ff-only'],cwd=path,timeout=180)
                if code: return self.send(500,{'ok':False,'error':err or out})
                return self.send(200,{'ok':True,'message':out or 'Projeto atualizado.'})
            return self.send(404,{'ok':False})
        except Exception as e: return self.send(500,{'ok':False,'error':str(e)})

print(f'Coucou Termux Agent online em http://{HOST}:{PORT}')
print(f'Projetos: {ROOT}')
ThreadingHTTPServer((HOST,PORT),H).serve_forever()
